# Postgres connection string. Locally: `createdb lastmile_delivery` then use
# postgresql://<user>@localhost:5432/lastmile_delivery?schema=public
# In production (e.g. Railway), use the DATABASE_URL the platform provides.
DATABASE_URL="postgresql://user:password@localhost:5432/lastmile_delivery?schema=public"

# JWT signing secret for session cookies. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Optional. Leave both unset to use the built-in console-logging email
# provider (dev-friendly: every email is printed to the server log and
# still recorded in the NotificationLog table). Set both to send real
# email via Resend (https://resend.com — free tier available).
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="notifications@yourdomain.com"

# Optional. Leave unset to use the built-in console-logging SMS provider.
# Set all three to send real SMS via Twilio (free trial available).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Base URL of the deployed app (used in a couple of notification templates).
APP_BASE_URL="http://localhost:3000"
